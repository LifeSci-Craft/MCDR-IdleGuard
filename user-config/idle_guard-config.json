{
    "instance_name": "auto",
    "language": "auto",
    "debug": false,
    "sleep": {
        "idle_timeout": 3600.0,
        "min_uptime": 300.0,
        "check_interval": 600.0,
        "state_tick": 5.0,
        "wake_cooldown": 15.0,
        "confirm_timeout": 30.0,
        "busy_patterns": [
            "(?i)\\bbacking up\\b",
            "(?i)\\bbackup (?:has )?(?:started|begun|complete|completed|finished)\\b",
            "(?i)\\b(?:creating|preparing|starting) (?:the )?(?:world |server )?backup\\b",
            "(?i)\\bworld backup (?:started|created)\\b"
        ],
        "busy_hold_seconds": 300.0,
        "ignore_players": []
    },
    "startup": {
        "startup_timeout": 300.0,
        "stop_timeout": 180.0,
        "port_release_timeout": 60.0,
        "fallback_startup_seconds": 60.0,
        "hot_startup_window": 300.0,
        "max_wake_failures": 3
    },
    "announce": {
        "enabled": true,
        "tell_attempt_players": true,
        "sound": "minecraft:block.note_block.pling",
        "player_attempt_window": 600.0
    },
    "fake_server": {
        "enabled": true
    },
    "bus": {
        "bind": "auto",
        "token": "CHANGE_ME_填入与其他实例一致的随机串",
        "timeout": 3.0
    },
    "velocity_config": "auto",
    "servers": [
        {
            "name": "lobby",
            "host": "127.0.0.1",
            "port": 25565,
            "role": "watch",
            "auto_sleep": false,
            "auto_wake": true,
            "always_on": false,
            "bus": "127.0.0.1:25600",
            "start_command": null,
            "stop_command": null,
            "working_directory": null,
            "idle_timeout": null
        },
        {
            "name": "survival",
            "host": "127.0.0.1",
            "port": 25566,
            "role": "auto",
            "auto_sleep": true,
            "auto_wake": true,
            "always_on": false,
            "bus": "127.0.0.1:25601",
            "start_command": null,
            "stop_command": null,
            "working_directory": null,
            "idle_timeout": null
        }
    ]
}
